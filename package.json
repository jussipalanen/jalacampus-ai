{
  "name": "jalacampus-ai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A Finnish-language AI knowledge assistant demo for higher education.",
  "author": "Jussi Alanen <juzapala@gmail.com>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/migrate.ts",
    "db:embed": "node --experimental-strip-types --env-file-if-exists=.env scripts/embed.ts",
    "db:ingest": "node --experimental-strip-types --env-file-if-exists=.env scripts/ingest.ts",
    "db:search": "node --experimental-strip-types --env-file-if-exists=.env scripts/search.ts",
    "eval": "node --experimental-strip-types --env-file-if-exists=.env scripts/eval.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
