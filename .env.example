# Never commit real credentials. Copy to an untracked .env for local development.
# Local Docker PostgreSQL (compose.yaml) and server-side database access:
# POSTGRES_PASSWORD=choose-a-local-password
# DATABASE_URL=postgresql://jalacampus:choose-a-local-password@localhost:5432/jalacampus
# Integration tests only; the database name must end in _test because tests drop tables:
# TEST_DATABASE_URL=postgresql://jalacampus:choose-a-local-password@localhost:5432/jalacampus_test
# Future AI provider (not used yet):
# GEMINI_API_KEY=your-key-here
