#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

case "${1:-}" in
  up) docker compose up -d ;;
  down) docker compose down ;;
  restart) docker compose up -d --force-recreate ;;
  status) docker compose ps ;;
  logs) docker compose logs -f ;;
  *)
    echo "Usage: ./dev {up|down|restart|status|logs}" >&2
    exit 2
    ;;
esac
